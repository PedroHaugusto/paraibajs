# Copie para .env.local e preencha. O .env.local não vai para o git.

# Chave da Resend (https://resend.com/api-keys).
# Sem ela, em desenvolvimento os formulários imprimem o conteúdo no terminal
# em vez de enviar; em produção o envio falha com mensagem clara.
RESEND_API_KEY=

# Para onde vão os formulários (CFP, voluntários, contato).
EMAIL_ORGANIZACAO=contato@paraibajs.dev

# Remetente. Precisa ser um domínio verificado na Resend.
# Enquanto não houver domínio verificado, use onboarding@resend.dev.
EMAIL_REMETENTE="ParaibaJS <onboarding@resend.dev>"
